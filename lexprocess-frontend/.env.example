REACT_APP_API_BASE_URL=http://localhost:8000/api/v1

# Ajusta esta URL según el entorno (desarrollo, staging, producción).
# El frontend asume que los endpoints de autenticación están en:
#   ${REACT_APP_API_BASE_URL}/token/
#   ${REACT_APP_API_BASE_URL}/token/refresh/
# Y recursos como casos en:
#   ${REACT_APP_API_BASE_URL}/casos/
